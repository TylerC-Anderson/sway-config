# Config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

# Thin top-level config: include purpose-split parts in order
include ~/.config/sway/conf.d/00-variables.conf
include ~/.config/sway/conf.d/05-fonts.conf
include ~/.config/sway/conf.d/10-env-and-agents.conf
include ~/.config/sway/conf.d/20-autostart.conf
include ~/.config/sway/conf.d/25-plugins.conf
include ~/.config/sway/conf.d/30-input.conf
include ~/.config/sway/conf.d/40-outputs.conf
include ~/.config/sway/conf.d/50-appearance.conf
include ~/.config/sway/conf.d/60-workspaces.conf
include ~/.config/sway/conf.d/65-bindings-core.conf
include ~/.config/sway/conf.d/66-bindings-workspaces.conf
include ~/.config/sway/conf.d/67-bindings-utilities.conf
include ~/.config/sway/conf.d/70-modes.conf
include ~/.config/sway/conf.d/80-bar.conf

# Keep any system includes last
include /etc/sway/config.d/*







########################################################
### === ARCHIVE BELOW IN CASE REFORMAT BORKED IT === ###

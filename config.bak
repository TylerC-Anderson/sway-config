#     ### References
#     bindsym $mod+Shift+r move container to workspace "ref"       
#     ### lookup/browser
#     bindsym $mod+Shift+b move container to workspace "brws"      

#     ## Main monitor, LG
#     ### middle misc
#     bindsym $mod+Shift+s move container to workspace "midl"      
#     ### Note-taking
#     bindsym $mod+Shift+n move container to workspace "note"      
#     ### coding workspace
#     bindsym $mod+Shift+v move container to workspace "code"      
#     ### research
#     bindsym $mod+Shift+x move container to workspace "rsrch"     
#     ### VM
